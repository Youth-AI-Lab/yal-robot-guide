# 6. The four layers: how fast each reacts, and who catches its mistakes.
# The lower the layer, the faster and the safer; it has the last word.

direction: down

ladder: "" {
  class: column
  grid-columns: 1
  grid-gap: 18
  human: "Human, the slowest: about a minute\nInterpreter (Feurisson) and the group\nmistake: a wrong mission → the group corrects it when Feurisson says it back" {class: part; width: 560}
  deliberative: "Deliberative: about a minute\nStrategist and its model (a few seconds per call)\nmistake: often → caught by the Pilot, the Referee, the Reflex" {class: part; width: 560}
  executive: "Executive: seconds (a cell takes about 3 s)\nPilot, Cartographer, Referee\nmistake: a wrong map → caught by the Referee and the Reflex" {class: part; width: 560}
  reactive: "Reactive, the fastest and safest: every 10 ms\nit has the last word\nReflex, on the robot\nmistake: a sensor misses something → an adult puts the robot back" {class: key; width: 560}
}
