#!/usr/bin/env python3
"""The whole robot in this Codespace, simulated: the simulator, the stack with the Strategist and its model, the
Interpreter's link, and Open WebUI with Feurisson, the Interpreter, ready to chat.

    robot-session start [--keep-traces]
                             everything, in order; then open the Ports tab: Robot simulator (8780), Open WebUI (3000)
    robot-session start --albert <model> [--keep-traces]
                             the same with Albert API (DINUM, for French public servants): <model> is Feurisson's,
                             the Strategist's is deepseek-v4-flash-0731
    robot-session status     what runs
    robot-session stop       everything stops; the traces are erased, or kept with --keep-traces at start

Two keys, one per tier (decision of Sébastien, 8 November 2026), never shown, never on a command line: Feurisson's is
the pair's, saved by workshop-login (an OpenRouter key, sk-or-...); the Strategist's, another one, is asked for at
start (typed, not shown, or the first line on stdin). With --albert, two Albert keys are asked for, Feurisson's then
the Strategist's. Each key has its own limit and its own count, and a runaway Strategist cannot use up Feurisson's.
Both models are DeepSeek v4 Flash through OpenRouter (whatever workshop-login --model chose, with OpenRouter told to
avoid companies that may collect the data); the Strategist stops a mission at RUN_CAP_USD of stack/strategist.py,
counted from the costs OpenRouter sends back. workshop-login --europe is refused for now: the Strategist has not been
tried with its models.

The traces (decision of Sébastien, 8 November 2026): by default, stop erases everything the session wrote in
.robot-sim (missions and their conversations with the model, the Referee's journal, the map of the terrain, the
counters) and Open WebUI with its conversations: a session with young people. --keep-traces keeps .robot-sim, and saves
Open WebUI's conversations there before removing it: a session of adults, or the simulator alone.
With --albert, both models are models of Albert API: no price, the content is not kept (metadata are, 24 months),
hosted in France; quotas per minute and per day, per model. Tried on 7 November 2026: deepseek-v4-flash-0731 did both
missions as the Strategist; Mistral Small 3.2 failed as the Strategist (the same refused call again and again, a
card reported where it never was) and as Feurisson (a mission started before the yes; then a call without a name,
and Albert refused the rest of the conversation).

How it is laid out (the guide's README, part 6): the simulator and the stack run in the Codespace itself; Open WebUI
runs in Docker, inside the Codespace, on a network of its own (robot-session). The Interpreter's link listens only on
that network's address in the Codespace, with a random token: Open WebUI reaches it, the Ports tab does not. Open
WebUI has no accounts (one person, or a pair, per Codespace): start refuses a public port 3000 or 8780 and status
shows one, as the kit's openwebui does (checked when the command runs: a port made public later is not seen). Never
with young people until the rules for that are decided.

For the checks (ci/check_session.py) and the trials only: ROBOT_STRATEGIST (none, fake, or another model for the
Strategist), ROBOT_MODEL, ROBOT_LANGUAGE_MODEL, ROBOT_OPENAI_BASE_URL (a fake model in this Codespace), ROBOT_CAP_USD
(the most a mission may cost, instead of RUN_CAP_USD).

Feurisson has a filter (interpreter/feurisson_filter.py): before each message of the group, the mission as it is now
and the group's language go into its instructions. The language is named by a small model of the same provider
(Mistral Small 3.2 through OpenRouter, Ministral 8B with Albert): the group's message goes to it too.
"""
import getpass
import json
import os
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

GUIDE = Path(__file__).resolve().parent.parent
STATE = GUIDE / ".robot-sim"
SESSION = STATE / "session"
PYTHON = "/opt/workshop/venv/bin/python" if Path("/opt/workshop/venv/bin/python").exists() else sys.executable
OWUI_IMAGE = os.environ.get("ROBOT_OPENWEBUI_IMAGE", "ghcr.io/open-webui/open-webui:v0.12.5")  # as the kit
OWUI, VOLUME, NETWORK = "robot-owui", "robot-owui-data", "robot-session"
OWUI_PORT, SIM_PORT, LINK_PORT = 3000, 8780, 8790
PORT_NAMES = {OWUI_PORT: "Open WebUI", SIM_PORT: "Robot simulator"}
MODEL = os.environ.get("ROBOT_MODEL", "deepseek/deepseek-v4-flash")
OPENROUTER_URL, ALBERT_URL = "https://openrouter.ai/api/v1", "https://albert.api.etalab.gouv.fr/v1"
ALBERT_STRATEGIST = "deepseek-v4-flash-0731"  # the only model of Albert seen doing the Strategist's missions
# The small, cheap model that names the group's language for the filter (interpreter/feurisson_filter.py).
SMALL = {OPENROUTER_URL: "mistralai/mistral-small-3.2-24b-instruct", ALBERT_URL: "ministral-3-8b-instruct-2512"}
FILTER = "feurisson_robot"
BOT, SERVER = "feurisson-robot", "robot-mission"
SCRIPTS = {"simulator": "sim/robot_sim.py", "link": "stack/interpreter_link.py"}
# The kit's choices (kit/.devcontainer/bin/openwebui): no built-in tool of Open WebUI (memories, other conversations,
# notes, code…), so Feurisson has only the link's tools; notes, automations and the calendar off for the instance.
BUILTIN_CATEGORIES = ["automations", "calendar", "channels", "chats", "code_interpreter", "files",
                      "image_generation", "knowledge", "memory", "notes", "notifications", "skills", "subagents",
                      "tasks", "time", "user_input", "web_search"]
NO_TOOLS = {"builtin_tools": False, "file_upload": False, "web_search": False, "image_generation": False,
            "code_interpreter": False, "file_context": False, "citations": False}


class Stop(Exception):
    """A start that did not go through: what started is stopped."""


def say(text):
    print(text, flush=True)


def fail(text):
    sys.exit(text)


def sh(*args, check=True, **kwargs):
    done = subprocess.run(args, capture_output=True, text=True, **kwargs)
    if check and done.returncode != 0:
        raise Stop(f"{' '.join(args[:3])}…: {done.stderr.strip()[-400:]}")
    return done


def provider():
    """The kit's workshop_provider (next to workshop-key in the image)."""
    helper = shutil.which("workshop-key")
    if helper is None:
        fail("This needs the workshop image (workshop-key): open this guide in its Codespace.")
    sys.path.insert(0, str(Path(helper).resolve().parent))
    import workshop_provider
    return workshop_provider


def saved_key():
    """The pair's key, as the kit's tools read it (by sudo when it belongs to root), and the routing of OpenRouter."""
    wp = provider()
    key = wp.read_key()
    if not key:
        fail("No key saved. Type: workshop-login   (an OpenRouter key, sk-or-...), then: robot-session start")
    if not key.startswith("sk-or-"):
        fail("This session needs an OpenRouter key (sk-or-...): the Strategist calls its model through OpenRouter. "
             "Type: workshop-login")
    if wp.europe():
        fail("workshop-login --europe is not ready for the robot: the Strategist has not been tried with its models. "
             "Type workshop-login --no-europe, or follow part 6 step by step.")
    return {"key": key, "routing": wp.routing(), "url": OPENROUTER_URL, "model": MODEL,
            "strategist": "openrouter:" + MODEL, "again": "robot-session start"}


def typed_key(question):
    """A key, typed (not shown) or the next line on stdin: it stays in memory."""
    key = getpass.getpass(question) if sys.stdin.isatty() else sys.stdin.readline()
    key = key.strip()
    if not key or any(c.isspace() for c in key):
        fail("No key given (one line, no spaces).")
    return key


def strategist_key(use):
    """The Strategist's own key: another key of the same provider, checked first (free)."""
    if use["url"] == ALBERT_URL:
        key = typed_key("The Strategist's Albert key, another one (not shown): ")
        albert_models(key)
    else:
        key = typed_key("The Strategist's key, another OpenRouter key (sk-or-..., not shown): ")
        if not key.startswith("sk-or-"):
            fail("The Strategist's key must be an OpenRouter key (sk-or-...).")
        if not os.environ.get("ROBOT_OPENAI_BASE_URL"):  # the checks talk to a fake model: no key to check
            request = urllib.request.Request(OPENROUTER_URL + "/key", headers={"Authorization": "Bearer " + key})
            try:
                urllib.request.urlopen(request, timeout=30).read()
            except urllib.error.HTTPError as e:
                fail(f"OpenRouter refused the Strategist's key (HTTP {e.code}).")
            except OSError as e:
                fail(f"OpenRouter does not answer: {e}")
    if key == use["key"]:
        fail("The Strategist needs a key of its own, not Feurisson's: create a second key (with its own limit) and "
             f"type it here. Then: {use['again']}")
    return key


def albert_models(key):
    request = urllib.request.Request(ALBERT_URL + "/models", headers={"Authorization": "Bearer " + key})
    try:
        with urllib.request.urlopen(request, timeout=30) as r:
            models = [m.get("id") for m in json.loads(r.read()).get("data", []) if m.get("type") == "text-generation"]
    except urllib.error.HTTPError as e:
        fail(f"Albert refused the key (HTTP {e.code}).")
    except OSError as e:
        fail(f"Albert does not answer: {e}")
    return models


def albert_key(model):
    """Feurisson's Albert key, typed (not shown) or on stdin; it stays in memory, and goes to Open WebUI. The key and
    the models are checked first, by Albert's list of models (free)."""
    model = model.removeprefix("albert:")
    key = typed_key("Feurisson's Albert key (not shown): ")
    models = albert_models(key)
    for wanted in (model, ALBERT_STRATEGIST, SMALL[ALBERT_URL]):
        if wanted not in models:
            fail(f"Albert has no model {wanted} today. Its models: {', '.join(sorted(m for m in models if m))}")
    return {"key": key, "routing": None, "url": ALBERT_URL, "model": model, "strategist": "albert:" + ALBERT_STRATEGIST,
            "again": f"robot-session start --albert {model}"}


def needs_key(strategist):
    """As stack/interpreter_link.py: only a model of a provider reads a key."""
    return strategist not in ("none", "fake") and not strategist.startswith("ollama:")


# Processes of the session: a pid alone is not enough. pids.json stays in /workspaces when the Codespace stops, and
# after a restart the same number can be another program. A pid counts only with its start time and its script.
def start_time(pid):
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def is_ours(name, entry):
    try:
        pid = int(entry["pid"])
        command = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
    except (OSError, KeyError, TypeError, ValueError):
        return False
    return start_time(pid) == entry.get("start") and SCRIPTS[name] in command


def known():
    try:
        entries = json.loads((SESSION / "pids.json").read_text())
    except (OSError, ValueError):
        return {}
    return {n: e for n, e in entries.items() if n in SCRIPTS and isinstance(e, dict)}


def running():
    return {name: entry for name, entry in known().items() if is_ours(name, entry)}


def background(name, args, env=None, stdin=None):
    """A process of the session, on its own (a new process group: stop ends it and its children), its output in a log."""
    with (SESSION / f"{name}.log").open("w") as log:
        process = subprocess.Popen(args, cwd=GUIDE, env=env, stdin=subprocess.PIPE if stdin else subprocess.DEVNULL,
                                   stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    if stdin:
        process.stdin.write(stdin.encode())
        process.stdin.close()
    entries = known()
    entries[name] = {"pid": process.pid, "start": start_time(process.pid)}
    (SESSION / "pids.json").write_text(json.dumps(entries))
    return process


def wait_ready(name, process, word, seconds=60):
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        text = (SESSION / f"{name}.log").read_text(errors="replace")
        if word in text:
            return
        if process.poll() is not None:
            raise Stop(f"{name} stopped: {text.strip()[-400:]}")
        time.sleep(0.3)
    raise Stop(f"{name} did not start in {seconds} s: see {SESSION / (name + '.log')}")


def wait_port(name, process, host, port, seconds=20):
    """The link prints READY before it listens: it is ready when its port answers."""
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        if process.poll() is not None:
            raise Stop(f"{name} stopped: {(SESSION / (name + '.log')).read_text(errors='replace').strip()[-400:]}")
        try:
            socket.create_connection((host, port), timeout=1).close()
            return
        except OSError:
            time.sleep(0.3)
    raise Stop(f"{name} does not listen on {host}:{port}: see {SESSION / (name + '.log')}")


def gateway():
    """The address of the session's network in the Codespace: the only one the link listens on."""
    if sh("docker", "network", "inspect", NETWORK, check=False).returncode != 0:
        sh("docker", "network", "create", NETWORK)
    address = sh("docker", "network", "inspect", NETWORK, "-f", "{{(index .IPAM.Config 0).Gateway}}").stdout.strip()
    if not address:
        raise Stop(f"The network {NETWORK} has no gateway address: docker network rm {NETWORK}, then try again.")
    return address


def api(method, path, body=None, token=None):
    url = f"http://127.0.0.1:{OWUI_PORT}" + (path if path.startswith("/api/") else "/api/v1" + path)
    headers = {"Accept": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    data = None if body is None else json.dumps(body).encode()
    if data:
        headers["Content-Type"] = "application/json"
    with urllib.request.urlopen(urllib.request.Request(url, data=data, method=method, headers=headers),
                                timeout=60) as r:
        text = r.read().decode()
    return json.loads(text) if text else None


def open_webui_runs():
    return sh("docker", "inspect", "-f", "{{.State.Running}}", OWUI, check=False).stdout.strip() == "true"


def start_openwebui(use, link_url, token):
    if sh("docker", "image", "inspect", OWUI_IMAGE, check=False).returncode != 0:
        say(f"First time: downloading Open WebUI ({OWUI_IMAGE}, about 1.6 GB, a few minutes)…")
        if subprocess.run(["docker", "pull", OWUI_IMAGE]).returncode != 0:
            raise Stop("The download failed. Check the network, then type: robot-session start")
    servers = [{"type": "mcp", "url": link_url, "path": "", "auth_type": "bearer", "key": token, "headers": None,
                "forward_cookies": False, "config": {"enable": True, "function_name_filter_list": ""},
                "info": {"id": SERVER, "name": "Robot mission",
                         "description": "Give the robot a mission, pause it, stop it, read its report."}}]
    # The routing of OpenRouter, as the kit's routed(): a text, read as JSON. None with Albert.
    routed = {"custom_params": {"provider": json.dumps(use["routing"])}} if use["routing"] else {}
    model = use["model"]
    env = {
        "ENABLE_OLLAMA_API": "false", "OLLAMA_BASE_URL": "http://127.0.0.1:11434", "ENABLE_OPENAI_API": "true",
        "OPENAI_API_BASE_URL": os.environ.get("ROBOT_OPENAI_BASE_URL", use["url"]),
        "OPENAI_API_CONFIGS": json.dumps({"0": {"enable": True, "model_ids": [model]}}),
        "DEFAULT_MODEL_PARAMS": json.dumps(routed), "DEFAULT_MODELS": BOT,
        "ENABLE_PERSISTENT_CONFIG": "false", "ENABLE_TITLE_GENERATION": "false", "ENABLE_TAGS_GENERATION": "false",
        "ENABLE_FOLLOW_UP_GENERATION": "false", "ENABLE_AUTOCOMPLETE_GENERATION": "false",
        "ENABLE_RETRIEVAL_QUERY_GENERATION": "false", "ENABLE_SEARCH_QUERY_GENERATION": "false",
        "ENABLE_EVALUATION_ARENA_MODELS": "false", "ENABLE_COMMUNITY_SHARING": "false",
        "ENABLE_CODE_INTERPRETER": "false", "ENABLE_WEB_SEARCH": "false", "ENABLE_NOTES": "false",
        "ENABLE_AUTOMATIONS": "false", "ENABLE_CALENDAR": "false", "OFFLINE_MODE": "true",
        "SCARF_NO_ANALYTICS": "true", "DO_NOT_TRACK": "true", "ANONYMIZED_TELEMETRY": "false",
        "WEBUI_AUTH": "False", "WEBUI_NAME": "Feurisson, the robot's voice",
        "TOOL_SERVER_CONNECTIONS": json.dumps(servers),
    }
    # The key, and the link's token inside TOOL_SERVER_CONNECTIONS, go through a file read by docker and removed at
    # once, never on the command line (docker inspect still shows them to this account, as in the kit).
    with tempfile.NamedTemporaryFile("w", dir=SESSION, delete=False, prefix=".env-") as f:
        os.chmod(f.name, 0o600)
        f.write("".join(f"{k}={v}\n" for k, v in dict(env, OPENAI_API_KEY=use["key"]).items()))
    try:
        sh("docker", "run", "-d", "--name", OWUI, "--network", NETWORK, "-p", f"127.0.0.1:{OWUI_PORT}:8080",
           "-v", f"{VOLUME}:/app/backend/data", "--env-file", f.name, OWUI_IMAGE)
    finally:
        os.unlink(f.name)
    t0 = time.monotonic()
    while time.monotonic() - t0 < 600:
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{OWUI_PORT}/health", timeout=3):
                break
        except (urllib.error.URLError, OSError):
            if not open_webui_runs():
                raise Stop("Open WebUI stopped while starting")
            time.sleep(2)
    else:
        raise Stop("Open WebUI did not answer in 10 minutes")
    token_owui = api("POST", "/auths/signin", {"email": "", "password": ""})["token"]
    # The filter: before each message of the group, the mission as it is now and the group's language go into the
    # instructions, and the link learns that a new turn starts.
    api("POST", "/functions/create", {"id": FILTER, "name": "Feurisson robot",
                                      "content": (GUIDE / "interpreter" / "feurisson_filter.py").read_text(),
                                      "meta": {"description": "The mission now, the group's language, the turn."}},
        token=token_owui)
    if not (api("POST", f"/functions/id/{FILTER}/toggle", {}, token=token_owui) or {}).get("is_active"):
        raise Stop("Open WebUI did not switch the filter on")
    api("POST", f"/functions/id/{FILTER}/valves/update", {
        "language_model": os.environ.get("ROBOT_LANGUAGE_MODEL", SMALL.get(use["url"], "")),
        "language_extra": json.dumps({"provider": use["routing"]}) if use["routing"] else ""}, token=token_owui)
    system = (GUIDE / "interpreter" / "feurisson.md").read_text(encoding="utf-8")
    api("POST", "/models/create", {  # a new volume each session: neither model is there yet
        "id": BOT, "base_model_id": model, "name": "Feurisson robot", "is_active": True,
        "meta": {"description": "The voice of the robot: it gives the robot its missions.",
                 "toolIds": [f"server:mcp:{SERVER}"], "filterIds": [FILTER], "capabilities": NO_TOOLS,
                 "builtinTools": dict.fromkeys(BUILTIN_CATEGORIES, False)},
        "params": dict(routed, system=system, function_calling="native")}, token=token_owui)
    # The plain model, hidden from the list and without tools: chosen by its id, it still gets the routing.
    api("POST", "/models/create", {
        "id": model, "base_model_id": None, "name": model, "is_active": True,
        "meta": {"hidden": True, "capabilities": NO_TOOLS, "builtinTools": dict.fromkeys(BUILTIN_CATEGORIES, False)},
        "params": dict(routed, function_calling="legacy")}, token=token_owui)
    return round(time.monotonic() - t0)


# Public ports, as the kit's openwebui (port_is_public): asked from outside, a private port sends the visitor to
# GitHub's sign-in, a public one lets the request through. Only in a Codespace; "Private to Organization" is not seen.
class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def is_public(port):
    name, domain = os.environ.get("CODESPACE_NAME"), os.environ.get("GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN")
    if not name or not domain:
        return None
    try:
        with urllib.request.build_opener(NoRedirect).open(f"https://{name}-{port}.{domain}/", timeout=15):
            return True
    except urllib.error.HTTPError as e:
        return False if e.code in (301, 302, 303, 307, 308, 401, 403) else None
    except OSError:
        return None


def public_ports():
    """The ports of the session that are public, after asking GitHub to make them private (when gh may)."""
    public = [port for port in PORT_NAMES if is_public(port)]
    if public and shutil.which("gh"):
        for port in public:
            subprocess.run(["gh", "codespace", "ports", "visibility", f"{port}:private", "-c",
                            os.environ["CODESPACE_NAME"]], capture_output=True, timeout=30)
        time.sleep(3)
        public = [port for port in public if is_public(port)]
    return public


def refuse_public(public, again):
    lines = [f"Port {port} ({PORT_NAMES[port]}) is public: anyone with its link could use your key." for port in public]
    stop(quiet=True)
    fail("\n".join(lines) + "\nEverything was stopped. In the Ports tab (next to Terminal), right-click on each line "
         f"-> Port Visibility -> Private. Then type: {again}")


def start(albert=None, keep=False):
    if running():
        fail("A session already runs: robot-session status, or robot-session stop first.")
    use = albert_key(albert) if albert else saved_key()
    if keep:
        use["again"] += " --keep-traces"
    strategist = os.environ.get("ROBOT_STRATEGIST", use["strategist"])  # "none", "fake": the checks
    use["strategist_key"] = strategist_key(use) if needs_key(strategist) else ""
    if shutil.which("docker") is None or sh("docker", "info", check=False).returncode != 0:
        fail("Docker does not answer in this Codespace: wait a minute after it opens, then try again.")
    stop(quiet=True)  # what an earlier session left (a Codespace stopped without robot-session stop)
    SESSION.mkdir(parents=True, exist_ok=True)
    os.chmod(SESSION, 0o700)
    (SESSION / "session.json").write_text(json.dumps({"traces": "keep" if keep else "erase"}))
    try:
        seconds = begin(use)
    except BaseException as e:
        if sh("docker", "container", "inspect", OWUI, check=False).returncode == 0:
            (SESSION / "open-webui.log").write_text(sh("docker", "logs", OWUI, check=False).stdout[-20000:])
        stop(quiet=True)
        if isinstance(e, Stop):
            fail(f"{e}\nThe session did not start: everything was stopped. Logs in {SESSION}. Then: {use['again']}")
        raise
    public = public_ports()  # read once Open WebUI answers: a public port then lets the request through
    if public:
        refuse_public(public, use["again"])
    ready(seconds)


def begin(use):
    say("1. The simulator…")
    simulator = background("simulator", [sys.executable, "-I", "sim/robot_sim.py", "--port", str(SIM_PORT)])
    wait_ready("simulator", simulator, "READY")
    say("2. The stack and the Interpreter's link…")
    address = gateway()
    token = secrets.token_hex(24)
    env = dict(os.environ, MCP_TOKEN=token)
    strategist = os.environ.get("ROBOT_STRATEGIST", use["strategist"])  # "none", "fake": the checks
    link = background("link", [PYTHON, "-I", "stack/interpreter_link.py", "--host", address, "--port", str(LINK_PORT),
                               "--allowed-host", f"{address}:{LINK_PORT}", "--model", strategist]
                      + (["--cap", os.environ["ROBOT_CAP_USD"]] if os.environ.get("ROBOT_CAP_USD") else []),
                      env=env, stdin=use["strategist_key"] or None)
    wait_ready("link", link, "READY robot-mission")
    wait_port("link", link, address, LINK_PORT)
    say("3. Open WebUI, with Feurisson…")
    return start_openwebui(use, f"http://{address}:{LINK_PORT}/mcp", token)


def ready(seconds):
    kept = traces_kept()
    say(f"Ready (Open WebUI answered in {seconds} s).\n"
        f"  The robot: Ports tab, Robot simulator ({SIM_PORT}).\n"
        f"  Feurisson: Ports tab, Open WebUI ({OWUI_PORT}), then choose \"Feurisson robot\" and ask it a mission.\n"
        "  Keep both ports private. To end: robot-session stop\n"
        + ("  Traces: kept in .robot-sim when the session stops (--keep-traces: adults, or the simulator alone)."
           if kept else "  Traces: erased when the session stops (a session with young people). For adults or the "
                        "simulator alone: robot-session start --keep-traces"))


def traces_kept():
    try:
        return json.loads((SESSION / "session.json").read_text()).get("traces") == "keep"
    except (OSError, ValueError):
        return False  # erased: the rule, unless --keep-traces was chosen at start


def save_conversations():
    """--keep-traces: Open WebUI's conversations, into .robot-sim, before Open WebUI goes."""
    try:
        token = api("POST", "/auths/signin", {"email": "", "password": ""})["token"]
        chats = api("GET", "/chats/all", token=token)
    except (OSError, ValueError, KeyError, TypeError):
        return None
    path = STATE / f"conversations-{time.strftime('%Y%m%d-%H%M%S')}.json"
    path.write_text(json.dumps(chats, ensure_ascii=False, indent=1) + "\n")
    return path


def status():
    alive = running()
    link = "link" in alive
    owui = sh("docker", "ps", "--filter", f"name=^{OWUI}$", "--format", "{{.Status}}", check=False).stdout.strip()
    say(json.dumps({"simulator": "simulator" in alive, "link": link, "open_webui": owui or "not running",
                    "robot_waits_for_an_adult": link and (STATE / "waiting.json").exists(),
                    "public_ports": [port for port in PORT_NAMES if is_public(port)] if alive or owui else []},
                   indent=1))


def stop(quiet=False):
    """Ends the processes of the session (only those: their pid, start time and script), removes Open WebUI, its
    volume (the conversations) and its network, then erases the traces (.robot-sim), unless the session was started
    with --keep-traces: then Open WebUI's conversations are saved in .robot-sim first, and .robot-sim stays. quiet:
    within start, the logs and the network stay, nothing is erased."""
    session = SESSION.exists()
    kept = traces_kept()
    saved = save_conversations() if not quiet and kept and open_webui_runs() else None
    for entry in running().values():
        try:
            os.killpg(int(entry["pid"]), signal.SIGTERM)
        except OSError:
            pass
    end = time.monotonic() + 10
    while time.monotonic() < end and running():
        time.sleep(0.2)
    for entry in running().values():
        try:
            os.killpg(int(entry["pid"]), signal.SIGKILL)
        except OSError:
            pass
    left = []
    if shutil.which("docker"):
        # The network stays within start: empty, it lets nothing through, and a fake model of the checks listens on it.
        for what, name in (("container", OWUI), ("volume", VOLUME)) + ((("network", NETWORK),) if not quiet else ()):
            if sh("docker", what, "inspect", name, check=False).returncode != 0:
                continue  # not there
            command = ["docker", "rm", "-f", name] if what == "container" else ["docker", what, "rm", name]
            if sh(*command, check=False).returncode != 0:
                left.append(f"{what} {name}")
    (STATE / "waiting.json").unlink(missing_ok=True)  # the Strategist ended: nobody waits for an adult any more
    if quiet:
        (SESSION / "pids.json").unlink(missing_ok=True)
        return
    if left:
        fail(f"Could not remove: {', '.join(left)}. Docker may still be starting: try robot-session stop again in a "
             "minute.")
    if kept:
        shutil.rmtree(SESSION, ignore_errors=True)
        say("Stopped. The traces stay in .robot-sim (--keep-traces)"
            + (f"; Open WebUI's conversations are saved in {saved.relative_to(GUIDE)}." if saved else "."))
    elif session:
        shutil.rmtree(STATE, ignore_errors=True)  # missions, conversations with the model, journals, map, counters
        say("Stopped. The traces are erased: .robot-sim and Open WebUI's conversations.")
    else:
        say("Stopped. No session was running here: nothing to erase.")


def main():
    args = sys.argv[1:]
    keep = "--keep-traces" in args
    rest = [a for a in args if a != "--keep-traces"]
    if rest[:2] == ["start", "--albert"] and len(rest) == 3:
        start(albert=rest[2], keep=keep)
    elif rest == ["start"]:
        start(keep=keep)
    elif not keep and len(rest) == 1 and rest[0] in ("status", "stop"):
        {"status": status, "stop": stop}[rest[0]]()
    else:
        fail(__doc__.split("\n\n")[1])


if __name__ == "__main__":
    main()
